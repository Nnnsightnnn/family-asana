# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Auth
SESSION_SECRET=replace-me-with-a-long-random-string
SESSION_DAYS=90

# Email (magic links). Leave RESEND_API_KEY empty in dev to log links to the console.
RESEND_API_KEY=
RESEND_FROM="Family Asana <no-reply@example.com>"
APP_URL=http://localhost:5173

# Optional: comma-separated list of email addresses allowed to log in.
# Leave empty to allow anyone to sign up (fine for a family server behind Tailscale).
ALLOWED_EMAILS=

# Comma-separated list of email addresses granted admin access (/api/admin/*
# + the in-app /admin page). Leave empty for no admins.
ADMIN_EMAILS=

# OpenRouter — AI task scoping (mobilization). Leave OPENROUTER_API_KEY blank to disable
# scoping gracefully (new-task form falls back to a plain save; no errors).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FAST_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_SMART_MODEL=anthropic/claude-sonnet-4.6
OPENROUTER_APP_NAME=family-asana

# Offsite backups — Cloudflare R2 (S3-compatible). Read by scripts/admin.ps1
# on the Windows host. Leave BACKUP_R2_BUCKET empty to disable offsite push
# (`admin.ps1 offsite-push` becomes a no-op + log line; no errors).
#   BACKUP_R2_ENDPOINT          e.g. https://<accountid>.r2.cloudflarestorage.com
#   BACKUP_R2_BUCKET            the name you gave your R2 bucket
#   BACKUP_R2_ACCESS_KEY_ID     R2 API token id
#   BACKUP_R2_SECRET_ACCESS_KEY R2 API token secret
# Retention is enforced by an R2 lifecycle rule on the bucket (7 days), not
# by the script. See docs/WINDOWS-SETUP.md step 9b.
BACKUP_R2_BUCKET=
BACKUP_R2_ENDPOINT=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
